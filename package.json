{
  "name": "dsh-plugin-pomodoro",
  "version": "1.0.1",
  "description": "Pomodoro timer widget in the DeepSeek Harness Web UI composer dock (25/5/15 with auto phase cycling, chime, zh/en).",
  "license": "MIT",
  "author": {
    "name": "tomhan00",
    "url": "https://github.com/tomhan00"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomhan00/dsh-pomodoro.git"
  },
  "bugs": {
    "url": "https://github.com/tomhan00/dsh-pomodoro/issues"
  },
  "homepage": "https://github.com/tomhan00/dsh-pomodoro#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "pomodoro",
    "timer",
    "productivity"
  ],
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
